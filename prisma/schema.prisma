// TSC ProcureFlow — WWF-RDC Procurement Prototype.
// Provider: PostgreSQL (production target — same in local dev for parity).
// String-typed enum-like columns are validated at the application layer
// (see src/lib/enums.ts) so the schema remains portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  password     String
  role         String   // Role enum (see src/lib/enums.ts)
  departmentId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  department         Department?           @relation(fields: [departmentId], references: [id])
  managedDepartments Department[]          @relation("DepartmentManager")
  requisitions       PurchaseRequisition[] @relation("RequesterRequisitions")
  approvals          Approval[]
  receipts           GoodsReceipt[]        @relation("ReceiverReceipts")
  documents          Document[]            @relation("UploaderDocuments")
  supplierDocuments  SupplierDocument[]    @relation("SupplierDocumentUploader")
  auditLogs          AuditLog[]            @relation("ActorAuditLogs")
}

model Department {
  id            String  @id @default(cuid())
  name          String
  code          String  @unique
  managerUserId String?

  manager      User?                 @relation("DepartmentManager", fields: [managerUserId], references: [id])
  users        User[]
  requisitions PurchaseRequisition[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  projectCode String    @unique
  donor       String?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?

  budgetLines  BudgetLine[]
  requisitions PurchaseRequisition[]
}

model BudgetLine {
  id              String  @id @default(cuid())
  projectId       String
  code            String
  label           String
  allocatedBudget Float
  committedAmount Float   @default(0)
  spentAmount     Float   @default(0)
  currency        String  @default("USD")
  active          Boolean @default(true)

  project      Project               @relation(fields: [projectId], references: [id])
  requisitions PurchaseRequisition[]

  @@unique([projectId, code])
}

model Supplier {
  id                       String   @id @default(cuid())
  companyName              String
  taxId                    String?
  contactName              String?
  email                    String?
  phone                    String?
  address                  String?
  status                   String   @default("PENDING")        // SupplierStatus
  dueDiligenceStatus       String   @default("NOT_STARTED")    // DueDiligenceStatus
  score                    Int      @default(0)
  antiCorruptionSignedAt   DateTime?  // Annexe B — Lettre certification & engagement
  createdAt                DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  quotes         Quote[]
  documents      SupplierDocument[]
}

model PurchaseRequisition {
  id                   String   @id @default(cuid())
  requisitionNumber    String   @unique
  title                String
  description          String?  // long-form description (TDR §4.1)
  quantity             Int      @default(1)  // TDR §4.1 — quantité
  unit                 String   @default("unité") // unité de mesure (unité, jour, mois, kg, m, …)
  requesterId          String
  departmentId         String
  projectId            String
  budgetLineId         String
  amount               Float
  currency             String   @default("USD")
  procurementType      String   // ProcurementType
  justification        String
  status               String   @default("DRAFT") // RequisitionStatus
  priority             String   @default("NORMAL") // Priority
  currentApproverRole  String?  // Role
  submittedAt          DateTime?
  expectedDeliveryDate DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  requester      User           @relation("RequesterRequisitions", fields: [requesterId], references: [id])
  department     Department     @relation(fields: [departmentId], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  budgetLine     BudgetLine     @relation(fields: [budgetLineId], references: [id])
  approvals      Approval[]
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  documents      Document[]
  quotes         Quote[]
}

model Quote {
  // TDR §4.4 — Analyse des offres : devis fournisseurs comparables
  id              String   @id @default(cuid())
  requisitionId   String
  supplierId      String
  amount          Float
  currency        String   @default("USD")
  leadTimeDays    Int?
  paymentTerms    String?
  technicalScore  Int      @default(0) // /100
  notes           String?
  isWinner        Boolean  @default(false)
  receivedAt      DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
}

model Approval {
  id            String   @id @default(cuid())
  requisitionId String
  approverId    String
  approverRole  String   // Role
  decision      String   // ApprovalDecision
  comment       String?
  oldStatus     String   // RequisitionStatus
  newStatus     String   // RequisitionStatus
  decidedAt     DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  approver    User                @relation(fields: [approverId], references: [id])
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  poNumber      String    @unique
  requisitionId String
  supplierId    String
  amount        Float
  currency      String    @default("USD")
  status        String    @default("DRAFT") // POStatus
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  receipts    GoodsReceipt[]
}

model GoodsReceipt {
  id               String   @id @default(cuid())
  requisitionId    String
  purchaseOrderId  String
  receivedById     String
  receiptType      String   // ReceiptType: GRN | SAN
  receivedDate     DateTime @default(now())
  notes            String?
  discrepancyFlag  Boolean  @default(false)
  discrepancyNotes String?
  createdAt        DateTime @default(now())

  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User                @relation("ReceiverReceipts", fields: [receivedById], references: [id])
}

model Document {
  id                String   @id @default(cuid())
  requisitionId     String
  fileName          String
  fileType          String
  fileSize          Int
  fileUrl           String
  uploadedById      String
  documentCategory  String   // DocumentCategory
  uploadedAt        DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  uploadedBy  User                @relation("UploaderDocuments", fields: [uploadedById], references: [id])
}

model SupplierDocument {
  id               String   @id @default(cuid())
  supplierId       String
  fileName         String
  fileType         String
  fileSize         Int
  fileUrl          String
  uploadedById     String
  documentCategory String
  uploadedAt       DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  uploadedBy User     @relation("SupplierDocumentUploader", fields: [uploadedById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?  // Role
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  comment    String?
  timestamp  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])
}

model Setting {
  id    String @id
  value String
}
